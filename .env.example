# Guest sessions — use a long random value (at least 32 characters); server-side only.
GUEST_SESSION_SECRET=
# Optional canonical origin used for CSRF origin validation, e.g. https://synapse.example.com.
PUBLIC_APP_URL=

# Configure at least one AI provider key. Keep these server-side; never use NEXT_PUBLIC_.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Provider order. Providers without keys are skipped; errors/rate limits trigger fallback.
AI_PROVIDER_PRIORITY=gemini,groq,openrouter

# Model overrides; verify current availability in each provider console.
GEMINI_CHAT_MODEL=gemini-3.5-flash
GROQ_CHAT_MODEL=openai/gpt-oss-20b
OPENROUTER_CHAT_MODEL=openai/gpt-oss-20b:free
GEMINI_VISION_MODEL=gemini-flash-lite-latest

# Required in production unless GEMINI_API_KEY is configured; use a dedicated stable random key.
UPLOAD_TOKEN_SECRET=

# FalkorDB
FALKORDB_HOST=
# Required by the current connection configuration; use 6379 for the usual default port.
FALKORDB_PORT=6379
# This app requires credentials even if your server otherwise permits anonymous access.
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH_NAME=memory_agent
# Set true for FalkorDB Cloud/TLS endpoints; false for local plain TCP.
FALKORDB_TLS=false

# Recommended for Vercel/serverless deployments. Without these, a bounded in-memory
# fallback protects a single instance only and is not a durable global limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
